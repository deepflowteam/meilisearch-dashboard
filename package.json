{
  "name": "meilisearch-dashboard",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy": "nuxt generate && wrangler pages deploy .output/public --project-name=meilisearch --branch=main",
    "postinstall": "nuxt prepare",
    "format": "oxfmt",
    "lint": "oxlint",
    "check": "oxlint && oxfmt --check",
    "update:pkg": "bun x taze major -w --concurrency 3 --request-timeout 20000 --retry 6 && bun install",
    "clean": "rm -rf .nuxt node_modules bun.lock"
  },
  "dependencies": {
    "@nuxt/icon": "^2.5.1",
    "@nuxt/ui": "^4.11.1",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@vueform/slider": "^2.1.10",
    "@vueuse/core": "^14.4.0",
    "humanize-string": "^3.1.0",
    "json-editor-vue": "^0.19.2",
    "json-oneline-stringify": "^1.0.1",
    "jwt-encode": "^1.0.1",
    "maplibre-gl": "^6.10.0",
    "match-operator": "^0.3.1",
    "meilisearch": "^0.62.0",
    "meilisearch-filters": "^1.1.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "ulid": "^3.0.2",
    "v3-infinite-loading": "^1.3.2",
    "vue-tippy": "v6",
    "vue3-sortablejs": "^1.0.7",
    "xxh32": "^2.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "file-size": "^1.0.0",
    "globals": "^17.12.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "sass": "^1.104.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.132.0"
  },
  "resolutions": {
    "string-width": "4.2.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
